{
  "name": "careconnect-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-vector-icons/feather": "14.0.0",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-documents/picker": "12.0.3",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "react-native-keychain": "10.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@eslint/compat": "^1.2.9",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-ft-flow": "3.0.11",
    "hermes-eslint": "0.32.1",
    "babel-plugin-transform-inline-environment-variables": "0.4.4",
    "dotenv": "18.0.9",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "react-native start --port 8090",
    "android": "react-native run-android --port 8090 --active-arch-only",
    "doctor": "react-native doctor",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src App.tsx tests",
    "format": "prettier --check src App.tsx tests *.ts *.json *.js *.cjs",
    "format:write": "prettier --write src App.tsx tests *.ts *.json *.js *.cjs",
    "test": "jest --runInBand",
    "check": "npm run format && npm run lint && npm run typecheck && npm test"
  },
  "overrides": {
    "eslint-plugin-ft-flow": "$eslint-plugin-ft-flow"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "private": true
}
